.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.env

# Large artifacts — regenerate, don't commit.
# The dataset is deterministic from its seed, so committing 15MB of it would be storing
# something one command reproduces. data/sample/ holds a readable slice instead.
docs/sources/*.pdf
data/generated/
data/dataset/
outputs/
*.gguf
*.safetensors

# Fetched cap sheets: public facts, but the compilation is capsheets.com's and the HF
# dataset's work. Run the fetchers yourself rather than redistributing their corpus.
data/capsheets/
data/dataset_v2/
